# ===== Peregrine - example configuration =====
# Copy this file to ".env" then adjust the values:
#   cp .env.example .env
# The .env file contains secrets: never share it and never commit it to
# GitHub (it is already ignored by git).

# --- Panel ---
# Network address the panel is published on, on the host machine:
#   127.0.0.1 -> reachable only from this machine. Recommended: put a
#                reverse proxy (Caddy, Nginx) in front to handle HTTPS.
#   0.0.0.0   -> reachable directly from other machines, without a proxy.
PEREGRINE_BIND=127.0.0.1

# Port used to reach the panel (http://localhost:HOST_PORT).
HOST_PORT=3000

# Public URL where the panel is reachable (used for links, etc.).
APP_URL=http://localhost:3000

# --- Database ---
# Path to the SQLite database file. Its folder is created automatically.
DATABASE_PATH=/data/peregrine.db

# --- Game servers ---
# Host directory where game-server files are stored. Each server gets its
# own sub-folder here. On a server with a dedicated disk for game data
# (see docs/DEPLOYMENT.md), point this at that disk.
SERVERS_PATH=/srv/peregrine/servers

# Host directory where backup archives (.tar.gz) are stored, grouped in
# per-server sub-folders. By default it sits next to SERVERS_PATH so a
# single dedicated disk holds both live data and backups.
BACKUPS_PATH=/srv/peregrine/backups

# --- Host safety margin ---
# RAM (in MiB) and CPU cores Peregrine refuses to allocate to game
# servers, kept for the OS / Docker / the panel itself. The defaults
# (512 MiB + 0.5 core) are the realistic minimum for Debian + Docker +
# Peregrine + Caddy + fail2ban. Bump them on bigger hosts if you want
# more breathing room — e.g. a production-grade machine that runs
# other workloads alongside Peregrine should use 1024 + 1.
RESERVED_MEM_MB=512
RESERVED_CPUS=0.5

# --- SFTP ---
# Port the built-in SFTP server listens on. Set to 0 to disable SFTP
# access entirely.
SFTP_PORT=2022

# Network address the SFTP server is published on, on the host machine.
# 0.0.0.0 lets users connect from outside (the typical setup).
# 127.0.0.1 keeps SFTP local-only (e.g. accessed through an SSH tunnel).
PEREGRINE_SFTP_BIND=0.0.0.0

# --- Timezone (v0.22.4+) ---
# IANA timezone used by Peregrine for scheduled tasks (the "Planifications"
# tab). When you set a backup at 04:00 or a restart at 00:00, the
# scheduleWorker interprets those times in this timezone. If left
# unset, containers default to UTC, which on European hosts means a
# 04:00 schedule will actually fire at 06:00 your-local-time in
# summer (UTC+2) — confusing.
#
# Examples: Europe/Paris, Europe/London, America/New_York,
# Asia/Tokyo. See `timedatectl list-timezones` for the full list.
TZ=UTC

# --- Security ---
# Secret key used to sign login sessions (JSON Web Tokens).
# MUST be changed. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- First launch ---
# On the very first start, Peregrine has no accounts. Open the panel in
# your browser: a wizard will guide you through creating the administrator
# account (email + password).
