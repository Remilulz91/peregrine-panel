// Peregrine - database schema
//
// This file describes the database structure. It will actually be used
// from Phase 1 onwards. To generate the Prisma client and create the
// database:  npx prisma migrate dev
//
// Note: the SQLite provider does not support "enum". The affected fields
// (role, status) are therefore strings whose allowed values are listed
// in a comment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A panel user account.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String
  passwordHash String // password hashed with Argon2 (never in plain text)
  role         String   @default("USER") // "ADMIN" or "USER"
  createdAt    DateTime @default(now())

  servers Server[]
}

/// A game template: describes how to run a given game.
model GameTemplate {
  id             String @id @default(cuid())
  name           String // e.g. "Minecraft Java"
  dockerImage    String // e.g. "itzg/minecraft-server"
  startupCommand String
  stopCommand    String // command for a clean shutdown (e.g. "stop")
  variables      String @default("[]") // JSON: options configurable by the user

  servers Server[]
}

/// A game server created by a user (= one Docker container).
model Server {
  id            String   @id @default(cuid())
  name          String
  status        String   @default("INSTALLING") // INSTALLING | OFFLINE | STARTING | RUNNING | STOPPING
  containerId   String? // Docker container identifier
  dockerImage   String
  memoryLimitMb Int      @default(2048)
  cpuLimit      Float    @default(1)
  diskLimitMb   Int      @default(10240)
  volumeName    String // Docker volume holding the game files
  environment   String   @default("{}") // JSON: chosen variables (version, etc.)
  createdAt     DateTime @default(now())

  ownerId    String
  owner      User         @relation(fields: [ownerId], references: [id])
  templateId String
  template   GameTemplate @relation(fields: [templateId], references: [id])
  allocation Allocation?
}

/// A network port that can be reserved for a server.
model Allocation {
  id   String @id @default(cuid())
  ip   String @default("0.0.0.0")
  port Int    @unique

  serverId String? @unique
  server   Server? @relation(fields: [serverId], references: [id])
}
