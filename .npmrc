# Supply chain hardening (v0.35.0+).
# Forces strict, predictable behaviour for npm and blocks the silent
# upgrade vectors that supply-chain attackers exploit.

# Pin exact versions when running `npm install <pkg>` from CLI.
save-exact=true

# Refuse to install if the running Node does not satisfy `engines`
# in package.json. Prevents the same package.json behaving
# differently across machines.
engine-strict=true

# Always update package-lock.json (default true; explicit for clarity).
package-lock=true

# Refuse install if audit reports vulns at this level or higher.
audit-level=moderate

# Suppress the npm funding spam — clutters CI logs and serves no
# security purpose.
fund=false

# Loglevel: warn only (cleaner CI output, errors still surface).
loglevel=warn
